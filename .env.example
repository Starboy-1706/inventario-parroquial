# PostgreSQL gestionado (Supabase, Neon o instancia local)
DATABASE_URL="postgresql://user:password@host:5432/app_db"

# Clave humana para entrar en la ventana de acceso (mínimo 10 caracteres).
# Usa una frase larga que no reutilices en otros servicios.
ACCESS_PASSWORD="cambia-esta-frase-por-una-clave-larga"

# Secreto técnico para firmar sesiones (mínimo 32 caracteres, NO es la clave).
# Genera uno con: openssl rand -base64 48
SESSION_SECRET="genera-un-valor-aleatorio-largo-y-distinto"
